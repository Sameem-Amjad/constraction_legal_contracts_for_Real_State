# =============================================================================
# ConstrAction — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# =============================================================================

# ───── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ───── Stripe ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# $99 CAD one-off price ID
STRIPE_PRICE_SINGLE=price_...
# $349 CAD/mo price ID
STRIPE_PRICE_SUBSCRIPTION=price_...

# ───── Email (used inside Supabase Edge Functions) ──────────────────────────
# Set these via `supabase secrets set ...`, NOT in this Next.js env file.
SMTP_USER=roy@constraction.ca
SMTP_PASSWORD=your-gmail-app-password

# ───── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://constraction.ca
